@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IDbContextFactory<AppDb> F
<div style="background:#1b2a49">
    <div class="container d-flex flex-wrap align-items-center gap-3 py-2">
        @if (logo != null) { <img src="@logo" style="height:34px" /> }
        <a class="navbar-brand text-white fw-bold text-decoration-none me-auto" href="portal">@(inst ?? "Student Portal")</a>
        <NavLink class="text-white-50 text-decoration-none" href="portal" Match="NavLinkMatch.All"><i class="bi bi-house"></i> Home</NavLink>
        <NavLink class="text-white-50 text-decoration-none" href="portal/fees"><i class="bi bi-cash-coin"></i> Fees</NavLink>
        <NavLink class="text-white-50 text-decoration-none" href="portal/card"><i class="bi bi-person-badge"></i> ID Card</NavLink>
        <NavLink class="text-white-50 text-decoration-none" href="portal/password"><i class="bi bi-key"></i> Password</NavLink>
        <button class="btn btn-sm btn-outline-light" @onclick='() => Nav.NavigateTo("portal/logout", forceLoad: true)'>Logout</button>
    </div>
</div>
<main class="container py-3">@Body</main>
@code {
    string? inst, logo;
    protected override async Task OnInitializedAsync()
    {
        await using var db = await F.CreateDbContextAsync();
        var s = await db.Settings.FirstAsync(); inst = s.Name; logo = s.LogoPath;
    }
}
