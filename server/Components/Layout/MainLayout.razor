@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject ChatService Chat
@inject ChatNotifier Notifier
@inject IJSRuntime JS
<div class="d-flex">
    <nav class="sidebar text-white p-3">
        <h5 class="mb-4"><i class="bi bi-mortarboard-fill"></i> Coaching ERP</h5>
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><i class="bi bi-speedometer2"></i> Dashboard</NavLink>
        <NavLink class="nav-link" href="chats"><i class="bi bi-chat-dots"></i> Messages @if (unread > 0) { <span class="nav-badge">@unread</span> }</NavLink>
        <NavLink class="nav-link" href="students"><i class="bi bi-people"></i> Students</NavLink>
        <NavLink class="nav-link" href="students/new"><i class="bi bi-person-plus"></i> New Admission</NavLink>
        <NavLink class="nav-link" href="dues"><i class="bi bi-cash-coin"></i> Dues / Defaulters</NavLink>
        <NavLink class="nav-link" href="settlements"><i class="bi bi-calculator"></i> Settlements</NavLink>
        <NavLink class="nav-link" href="categories"><i class="bi bi-tags"></i> Categories</NavLink>
        <NavLink class="nav-link" href="batches"><i class="bi bi-collection"></i> Batches</NavLink>
        <NavLink class="nav-link" href="settings"><i class="bi bi-gear"></i> Settings / ID Card</NavLink>
        <hr />
        <button class="btn btn-sm btn-outline-light" @onclick='() => Nav.NavigateTo("account/logout", forceLoad: true)'><i class="bi bi-box-arrow-right"></i> Logout</button>
    </nav>
    <main class="flex-grow-1 p-4 content">@Body</main>
</div>
@code {
    int unread; bool subscribed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        subscribed = true; Notifier.Changed += OnChat;
        unread = await Chat.UnreadForAdminAsync(); StateHasChanged();
        await JS.InvokeVoidAsync("chatInit");
    }
    void OnChat(ChatEvent e) => _ = InvokeAsync(async () =>
    {
        unread = await Chat.UnreadForAdminAsync();
        if (e.Message is { FromAdmin: false })
            await JS.InvokeVoidAsync("chatNotify", e.StudentName ?? "New message", e.Message.Text ?? "📷 Photo");
        StateHasChanged();
    });
    public void Dispose() { if (subscribed) Notifier.Changed -= OnChat; }
}
