@page "/portal/card"
@attribute [Authorize(Roles = "Student")]
@layout PortalLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider Auth
<PageTitle>My ID Card</PageTitle>
<h4>Mera ID Card</h4>
@if (id > 0)
{
    <div class="mb-2"><a class="btn btn-sm btn-outline-dark" href="idcard/student/@id" target="_blank"><i class="bi bi-printer"></i> Print / bada karke kholein</a></div>
    <!-- Yahan embed=1 ki jagah embed=true kar diya hai -->
    <iframe src="idcard/student/@id?embed=true" style="width:100%;height:760px;border:1px solid #ddd;background:#e9ecef" title="ID Card"></iframe>
}
@code {
    int id;
    protected override async Task OnInitializedAsync() => id = await Auth.StudentIdAsync();
}