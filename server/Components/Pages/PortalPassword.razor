@page "/portal/password"
@attribute [Authorize(Roles = "Student")]
@layout PortalLayout
@rendermode InteractiveServer
@inject AuthenticationStateProvider Auth
@inject IDbContextFactory<AppDb> F
<PageTitle>Password</PageTitle>
<h4>Password badlein</h4>
<div class="card" style="max-width:420px"><div class="card-body">
    <input class="form-control mb-2" type="password" placeholder="Purana password" @bind="oldPw" />
    <input class="form-control mb-2" type="password" placeholder="Naya password (min 4)" @bind="newPw" />
    <input class="form-control mb-3" type="password" placeholder="Naya password dobara" @bind="confirm" />
    <button class="btn btn-primary" @onclick="Save">Change</button>
    <div class="mt-2 @(ok ? "text-success" : "text-danger")">@msg</div>
</div></div>
@code {
    string? oldPw, newPw, confirm, msg; bool ok;
    async Task Save()
    {
        ok = false;
        if ((newPw ?? "").Length < 4) { msg = "Naya password kam se kam 4 character ka ho"; return; }
        if (newPw != confirm) { msg = "Dono naye password same nahi hain"; return; }
        var id = await Auth.StudentIdAsync();
        await using var db = await F.CreateDbContextAsync();
        var s = await db.Students.FindAsync(id);
        if (s == null || !Security.Verify(oldPw ?? "", s.PasswordHash)) { msg = "Purana password galat hai"; return; }
        s.PasswordHash = Security.Hash(newPw!); await db.SaveChangesAsync();
        ok = true; msg = "Password badal gaya ✔"; oldPw = newPw = confirm = null;
    }
}
